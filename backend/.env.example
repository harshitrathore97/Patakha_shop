# Environment variables for PatakhaShop Backend
# Copy this file to .env and fill in your actual values

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/patakhashop?retryWrites=true&w=majority

# JWT Secret (generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Admin credentials (used ONLY during initial setup with npm run setup-admin)
ADMIN_EMAIL=admin@myshop.com
ADMIN_PASSWORD=YourSecurePassword123!

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Shop Config
SHOP_NAME=My Shop
SHOP_WHATSAPP=919610684627

# CORS - set to your frontend URL in production
FRONTEND_URL=http://localhost:5173
